# ==============================================================================
# Crystal Crest — Environment Configuration Template (.env.example)
# Copy this file to .env and fill in the values before starting the application.
# NEVER commit your actual .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME SETTINGS
# ------------------------------------------------------------------------------
# Server HTTP listening port (Default: 3000)
PORT=3000

# Application environment: 'development' or 'production' (Enables security hardening & strips stack traces)
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MySQL 8.0+)
# ------------------------------------------------------------------------------
# MySQL host address (e.g. 'localhost' or managed DB endpoint like AWS RDS / PlanetScale)
DB_HOST=localhost

# MySQL database username (Obtain from your MySQL server setup)
DB_USER=root

# MySQL user password (Use a strong password generated for your production database)
DB_PASSWORD=38556016ab

# MySQL database name (Default: 'crystal_crest')
DB_NAME=crystal_crest

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Secret key used to sign and verify JWT authentication cookies (Generate a 64+ char random string using `openssl rand -hex 32`)
JWT_SECRET=your_long_secure_random_jwt_secret_key_here

# ------------------------------------------------------------------------------
# 4. SAFARICOM M-PESA & DARAJA INTEGRATION
# ------------------------------------------------------------------------------
# Daraja Consumer Key (Obtain from Safaricom Daraja Developer Portal: https://developer.safaricom.co.ke)
MPESA_CONSUMER_KEY=your_safaricom_daraja_consumer_key

# Daraja Consumer Secret (Obtain from Safaricom Daraja Developer Portal: https://developer.safaricom.co.ke)
MPESA_CONSUMER_SECRET=your_safaricom_daraja_consumer_secret

# Daraja Lipa Na M-Pesa Online Passkey (Obtain from Daraja Portal upon Go-Live request or test passkey for sandbox)
MPESA_PASSKEY=your_daraja_production_passkey_here

# Business ShortCode / PayBill (Default Co-operative Bank Paybill: '400200' or your organization shortcode)
MPESA_SHORTCODE=400200

# Bank Account Number / Reference for Paybill destination (e.g. Co-op Bank Account '104514')
MPESA_ACCOUNT_REFERENCE=104514

# M-Pesa environment: 'production' for live payments or 'sandbox' for test testing
MPESA_ENV=production

# Full public HTTPS URL where Safaricom sends payment webhook callbacks (e.g. 'https://yourdomain.com/api/payments/mpesa-callback')
MPESA_CALLBACK_URL=https://your-live-domain.com

# General payments mode: 'live' for real payment gateway processing or 'simulation' for offline staging tests
PAYMENTS_MODE=live

# Fallback to simulation if Safaricom credentials fail during local testing ('true' or 'false')
MPESA_FALLBACK_SIMULATION=true

# ------------------------------------------------------------------------------
# 5. CRESTI AI BEAUTY CONCIERGE (Google Gemini API)
# ------------------------------------------------------------------------------
# Google Gemini API Key for Cresti AI Skincare & Beauty Formulations (Obtain free at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_google_gemini_api_key_here

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL & NEWSLETTER (Brevo / Sendinblue)
# ------------------------------------------------------------------------------
# Brevo API Key for order confirmations and marketing newsletters (Obtain at https://app.brevo.com/settings/keys/api)
BREVO_API_KEY=your_brevo_api_key_here

# Verified sender email address registered on your Brevo account (e.g. 'concierge@crystalcrest.co.ke')
BREVO_SENDER_EMAIL=concierge@crystalcrest.co.ke

# Display name for transactional emails sent to customers
BREVO_SENDER_NAME="Crystal Crest Luxury Boutique"

# ------------------------------------------------------------------------------
# 7. CUSTOMER EMAIL OTP LOGIN (Gmail SMTP via Nodemailer)
# ------------------------------------------------------------------------------
# Gmail address used only to SEND customer login verification codes.
EMAIL_USER=your_gmail_address@gmail.com

# Gmail "App Password" (NOT your real Gmail password). Requires 2-Step Verification
# to be enabled on the Google account. Generate one at: https://myaccount.google.com/apppasswords
EMAIL_APP_PASSWORD=your_16_character_gmail_app_password
